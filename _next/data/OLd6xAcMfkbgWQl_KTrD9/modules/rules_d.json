ted in the root module.","type":1,"mandatory":false,"providerNameGroup":[],"defaultValue":"\"d\"","nonconfigurable":false,"nativelyDefined":false},{"name":"d_version","docString":"Fully qualified compiler version, for example \"dmd-2.111.0\" or \"ldc-1.41.0\".\nThe extension selects the first supplied version compatible with the current platform\nand fails if none match.","type":4,"mandatory":true,"providerNameGroup":[],"defaultValue":"","nonconfigurable":false,"nativelyDefined":false}]}],"originKey":{"name":"","file":"//d:extensions.bzl"}}],"repositoryRuleInfo":[],"macroInfo":[]},{"ruleInfo":[],"providerInfo":[],"funcInfo":[{"functionName":"http_archive","parameter":[{"name":"name","docString":"","defaultValue":"","mandatory":true,"role":0},{"name":"kwargs","docString":"","defaultValue":"","mandatory":false,"role":0}],"docString":"","originKey":{"name":"http_archive","file":"//d:repositories.bzl"}},{"functionName":"rules_d_dependencies","parameter":[],"docString":"","originKey":{"name":"rules_d_dependencies","file":"//d:repositories.bzl"}},{"functionName":"d_register_toolchains","parameter":[{"name":"name","docString":"base name for all created repositories","defaultValue":"","mandatory":true,"role":0},{"name":"register","docString":"whether to call through to native.register_toolchains.\nShould be True for WORKSPACE users, but false when used under bzlmod extension","defaultValue":"True","mandatory":false,"role":0},{"name":"kwargs","docString":"passed to each d_repositories call","defaultValue":"","mandatory":false,"role":0}],"docString":"Convenience macro for users which does typical setup.\n\n- create a repository for each built-in platform like \"d_linux_amd64\"\n- TODO: create a convenience repository for the host platform like \"d_host\"\n- create a repository exposing toolchains for each platform like \"d_platforms\"\n- register a toolchain pointing at each platform\nUsers can avoid this macro and do these steps themselves, if they want more control.\n","ori